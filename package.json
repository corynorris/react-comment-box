{
	"name": "react-comment-box",
	"version": "2.0.0",
	"description": "A simple comment box with markdown support",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx server/index.ts --dev",
		"build": "vite build && tsc -p tsconfig.server.json",
		"start": "node dist/server/index.js",
		"preview": "vite preview",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix ."
	},
	"dependencies": {
		"dompurify": "^3.5.0",
		"express": "^5.3.0",
		"marked": "^18.2.1",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/dompurify": "^3.2.0",
		"@types/express": "^5.0.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.8",
		"prettier": "^3.10.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8"
	}
}
